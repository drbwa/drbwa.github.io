---
import Base from './Base.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<Base title={title} description={description}>
  <div class="wrap">
    <h1 class="page-title">{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>
