---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Subscribe from '../../components/Subscribe.astro';
import '../../styles/prose.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const description =
  'Notes on distributed systems, operations, and getting useful work out of models.';
---
<Base title="Writing" description={description}>
  <div class="wrap">
    <h1 class="page-title">Writing</h1>
    <div class="prose">
      <p>I write occasionally about distributed systems, operating software in the real world, and getting useful work out of language models. There is usually a diagram. If you’d like, new posts can arrive by email.</p>
    </div>

    {posts.length > 0
      ? <PostList posts={posts} />
      : <p class="prose">Nothing published yet.</p>}

    <Subscribe />
  </div>
</Base>
